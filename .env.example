# Kiro Gateway - Configuração

# Porta do servidor (Square Cloud usa 80, local usa 8000)
# SERVER_PORT=8000

# Caminho do binário kiro-cli (deixe vazio pra autodetectar em ./bin/kiro-cli)
# KIRO_CLI_PATH=/caminho/para/kiro-cli

# Nível de log
# LOG_LEVEL=INFO

# A senha do admin NÃO fica aqui — é definida no primeiro acesso ao /admin
# e armazenada no SQLite (admin.db).
